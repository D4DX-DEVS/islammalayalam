{
  "name": "islammalayalam",
  "version": "0.1.0",
  "private": true,
  "description": "IslamMalayalam.net — Next.js + Payload CMS rebuild of the legacy WordPress site",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3444",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3444",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed:dev": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/dev/seed.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload run migration/run.ts",
    "dev:migration": "tsx scripts/dev/dev-migration.ts",
    "preview:production": "tsx scripts/dev/preview-production.ts",
    "test:unit": "vitest run --config ./vitest.config.mts --project unit",
    "test:int": "vitest run --config ./vitest.config.mts --project int",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test": "npm run test:unit && npm run test:int",
    "env:check": "node scripts/env-check.mjs"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "graphql": "16.11.0",
    "htmlparser2": "12.0.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "payload": "3.90.2",
    "payload-totp": "3.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "otpauth": "9.5.2",
    "postcss": "8.5.28",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "undici": "7.29.1"
  }
}
